# Window Settings
background-opacity = 0.7

fullscreen = true
window-decoration = false
title = "Ghostty"
command = "tmux attach-session -t default >/dev/null 2>&1 || tmux new-session -s default "

# background-blur-radius = 20

# font
font-size = 11
font-family = "JetBrains Mono"

# cursor
cursor-style-blink = false 
# cursor-style = block

# theme
theme = "ghostty"

# notifications
confirm-close-surface = false
