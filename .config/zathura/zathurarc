# place in ~/.config/zathura/
# Zathura configuration file
# See man `man zathurarc'
#-----------------------------
include colors

# enable clipboard
set selection-clipboard "clipboard"

# See man `man zathurarc'
map r reload
map p print
map i recolor # invert the coloring
map E zoom out
map e zoom in
map R rotate

# set window-width 1000
set window-height 1000
# Open document in fit-width mode by default
set adjust-open "best-fit"

set window-title-basename true
set window-title-page true

set statusbar-basename true
set statusbar-page-percent true

set continuous-hist-save true
set zoom-center true
set vertical-center true

# One page per row by default
set pages-per-row 1

set double-click-follow false
# scrollbars

#stop at page boundries
set scroll-page-aware "true"
set scroll-full-overlap 0.01
set scroll-step 100

#zoom settings
set zoom-min 10
set guioptions ""

set recolor-reverse-video "true"
set recolor-keephue "true"
set font "FiraCodeNerdFont 10"
set selection-notification false
set show-directories false

# # Recolor book content's color
set recolor "true"
set recolor-lightcolor "#000000" #00
set recolor-darkcolor "#ffffff" #06
